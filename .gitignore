# OS
.DS_Store
Thumbs.db

# Editors and IDEs
.idea/
.vscode/
*.swp
*.swo
*~

# Claude Code local state
.claude/worktrees/
.claude/settings.local.json

# Local tool state
.serena/

# BMad: personal layers and setup temp files.
# Team config and shared scripts under _bmad/ are tracked.
_bmad/**/*.user.toml
.bmad-help-setup-modules*.toml

# BMad's own tests for its scripts. Setup copies them in, but they need
# files that exist only in BMad's repository, so they cannot run here.
_bmad/scripts/tests/
_bmad/render/

# BMad run working files: decision logs, review and reconcile scratch.
# Finished deliverables such as prd.md and addendum.md are tracked.
_bmad-output/**/.memlog.md
_bmad-output/**/review-*.md
_bmad-output/**/reconcile-*.md
_bmad-output/**/validation-report.*

# Environment and secrets
.env
.env.*
!.env.example

# Dependencies, caches, and build output
node_modules/
__pycache__/
*.pyc
.venv/
dist/
build/
*.log
.coverage/
.pytest_cache/
.ruff_cache/
.mypy_cache/
